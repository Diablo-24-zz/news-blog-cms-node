{
  "name": "news-cms",
  "version": "1.0.0",
  "private": true,
  "description": "A role-aware news and blog CMS built with Express and MySQL.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup-db": "node scripts/setup-databases.js",
    "create-super-admin": "node scripts/create-super-admin.js",
    "seed-demo": "node scripts/seed-demo.js",
